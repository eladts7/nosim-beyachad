rules_version = '2';
// Driver verification documents: the driver uploads, the driver and staff read.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()));
    }
    match /driverDocs/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}
