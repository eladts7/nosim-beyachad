{
  "appId": "il.nosimbeyachad.app",
  "appName": "נוסעים ביחד",
  "webDir": "www",
  "server": {
    "url": "https://nosim-beyachad.vercel.app",
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "backgroundColor": "#f6f4ef",
  "android": { "allowMixedContent": false },
  "ios": { "contentInset": "never" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 800, "backgroundColor": "#1d2433", "showSpinner": false },
    "StatusBar": { "style": "DARK", "backgroundColor": "#1d2433", "overlaysWebView": false },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] },
    "FirebaseAuthentication": { "skipNativeAuth": true, "providers": ["google.com"] }
  }
}
